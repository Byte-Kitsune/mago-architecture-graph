    {
      "id": "area-controller",
      "path_pattern": "src/Area/*/Controller/",
      "namespace_prefix": "App\\Area\\",
      "layer": "controller",
      "allowed_target_layers": ["service"],
      "entrypoint_suffix": "Controller",
      "module_family": "area"
    },
    {
      "id": "area-service",
      "path_pattern": "src/Area/*/Service/",
      "namespace_prefix": "App\\Area\\",
      "layer": "service",
      "allowed_target_layers": [],
      "entrypoint_suffix": "Service",
      "module_family": "area"
    }
  ]
}
